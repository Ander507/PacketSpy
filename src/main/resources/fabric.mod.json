{
  "schemaVersion": 1,
  "id": "packetspy",
  "version": "${version}",
  "name": "PacketSpy",
  "description": "This adds console / log to spy on packets",
  "authors": ["Ander507"],
  "contact": {
    "sources": "https://github.com/Ander507/PacketSpy",
    "issues": "https://github.com/Ander507/PacketSpy/issues"
  },
  "license": "MIT",
  "icon": "assets/packetspy/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.ander507.packetspy.client.PacketspyClient"
    ]
  },
  "mixins": [
    {
      "config": "packetspy.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
